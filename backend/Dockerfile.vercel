# --- Build stage ---
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy project manifest first so Docker can cache the restore layer
COPY HelloWorld.csproj ./
RUN dotnet restore

# Copy all source files (Models/, Services/, Controllers/, Program.cs)
COPY . .
RUN dotnet publish -c Release --no-restore -o /app/publish /p:UseAppHost=false

# --- Runtime stage ---
# Standard Debian-based image: required by Vercel's container runtime
# (chiseled/distroless images strip system libs that Vercel's health checks need)
FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app

COPY --from=build /app/publish ./

# Vercel injects PORT at runtime — do not hardcode 80.
# DOTNET_EnableDiagnostics=0 disables the diagnostics server (dotnet-counters /
# dotnet-trace) but does NOT suppress application logging.
ENV DOTNET_EnableDiagnostics=0

ENTRYPOINT ["dotnet", "BIDashboard.dll"]
